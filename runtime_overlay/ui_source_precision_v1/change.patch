+def _score(query: str, tag: str, label: str, attrs: Dict[str, str]) -> tuple[int, List[str], Dict[str, Any]]:
+    tokens = {word for word in _words(query) if len(word) >= 2 and word not in QUERY_STOPWORDS}
+    label_words = _words(label)
+    label_matches = sorted(tokens.intersection(label_words))
+    # Short words may distinguish labels such as "Sign in" and "Sign up", but
+    # matching one in a long placeholder is weak evidence of control identity.
+    attribute_tokens = {word for word in tokens if len(word) >= 3}
+    attribute_matches = {name: sorted(attribute_tokens.intersection(_words(value)))
+                         for name, value in sorted(attrs.items())}
