+                size = 0
+                # O_NOFOLLOW prevents a path swapped to an external symlink
+                # after lstat from redirecting the byte read outside the repo.
+                fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+                with os.fdopen(fd, "rb") as stream:
+                    opened = os.fstat(stream.fileno())
+                    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                        h.update(chunk)
+                        size += len(chunk)
+                    after_read = os.fstat(stream.fileno())
+                after = path.lstat()
+                identity = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+                stable = (
+                    stat.S_ISREG(opened.st_mode)
+                    and identity(before) == identity(opened) == identity(after_read) == identity(after)
+                    and size == after.st_size
+                )
+                row.update(kind="file", sha256=h.hexdigest(), size=size, stable_during_read=stable)
+                complete = complete and stable
+            else:
+                row["kind"] = "non_file_unbound"
+                complete = False
+        except FileNotFoundError:
+            row["kind"] = "missing"
+        except OSError:
+            row["kind"] = "unreadable"
+            complete = False
+        rows.append(row)
+    return {
+        "dirty_content_digest": _digest(rows),
+        "dirty_content_complete": complete,
+        "dirty_path_count": len(rows),
+    }
