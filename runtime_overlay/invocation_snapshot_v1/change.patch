+def _dirty_content_evidence(root: Path, status: Optional[str]) -> Dict[str, Any]:
+    """Bind Git-visible dirty paths to their worktree bytes, without following links."""
+    if status is None:
+        return {"dirty_content_digest": None, "dirty_content_complete": False, "dirty_path_count": None}
+    if not status:
+        return {"dirty_content_digest": _digest([]), "dirty_content_complete": True, "dirty_path_count": 0}
+
+    paths: set[bytes] = set()
+    try:
+        for command in (
+            ("diff", "HEAD", "--name-only", "-z", "--no-ext-diff"),
+            ("ls-files", "--others", "--exclude-standard", "-z"),
+        ):
+            proc = subprocess.run(
+                ["git", "-C", str(root), *command], check=False,
+                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10,
+            )
+            if proc.returncode:
+                raise OSError("dirty path enumeration failed")
+            paths.update(path for path in proc.stdout.split(b"\0") if path)
+    except (OSError, subprocess.TimeoutExpired):
+        return {"dirty_content_digest": None, "dirty_content_complete": False, "dirty_path_count": None}
+
+    rows: List[Dict[str, Any]] = []
+    complete = True
+    for raw_path in sorted(paths):
+        row: Dict[str, Any] = {"path_hex": raw_path.hex()}
+        # Git normally emits relative paths. Refuse traversal if a repository
+        # adapter ever returns an unexpected name instead of reading outside it.
+        if raw_path.startswith(b"/") or b".." in raw_path.split(b"/"):
+            row["kind"] = "path_outside_root"
+            complete = False
+            rows.append(row)
+            continue
+        path = root / os.fsdecode(raw_path)
+        try:
+            before = path.lstat()
+            if stat.S_ISLNK(before.st_mode):
+                data = os.fsencode(os.readlink(path))
+                after = path.lstat()
+                stable = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) == (
+                    after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns
+                )
+                row.update(kind="symlink", sha256=hashlib.sha256(data).hexdigest(), size=len(data), stable_during_read=stable)
+                complete = complete and stable
+            elif stat.S_ISREG(before.st_mode):
