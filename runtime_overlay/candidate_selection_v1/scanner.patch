+def _js_boolean_guard_condition_facts(raw_condition: str) -> Dict[str, Any]:
+    """Return bounded facts for the strict-equality boolean-guard capability lane."""
+    condition = raw_condition.strip()
+    strict = re.fullmatch(
+        r"(?P<left>[A-Za-z_$][A-Za-z0-9_$]*(?:\.[A-Za-z_$][A-Za-z0-9_$]*)*)"
+        r"\s*(?P<op>===)\s*(?P<right>'(?:\\.|[^'\\])*'|\"(?:\\.|[^\"\\])*\")",
+        condition,
+        flags=re.S,
+    )
+    if not strict:
+        return {
+            "condition_operator": None,
+            "left_operand_class": None,
+            "right_operand_class": None,
+            "strict_equality_string_literal": False,
+        }
+    return {
+        "condition_operator": strict.group("op"),
+        "left_operand_class": "IDENT_OR_MEMBER_CHAIN_NO_OPTIONAL_CHAINING",
+        "right_operand_class": "STRING_LITERAL",
+        "strict_equality_string_literal": True,
+    }
