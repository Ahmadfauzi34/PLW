+def cmd_candidate(args: List[str]) -> int:
+    """Task-bound exact candidate selection and internal capability matching."""
+    if not args or args[0] in ("-h", "--help"):
+        print("Usage: plw candidate select <task> [root] [--json]")
+        print("       plw candidate capability-match <task> [root] [--json]")
+        return 0 if args else 2
+    mode = args[0].lower().replace("_", "-")
+    if mode not in ("select", "capability-match"):
+        print(f"[PLW Error] Unknown candidate subcommand: {args[0]}", file=sys.stderr)
+        return 2
+    if len(args) < 2:
+        print("[PLW Error] candidate task is required", file=sys.stderr)
+        return 2
+    task = args[1]
+    root = "."
+    as_json = False
+    for arg in args[2:]:
+        if arg == "--json":
+            as_json = True
+        elif arg.startswith("-"):
+            print(f"[PLW Error] Unknown candidate argument: {arg}", file=sys.stderr)
+            return 2
+        elif root == ".":
+            root = arg
+        else:
+            print(f"[PLW Error] Unexpected candidate argument: {arg}", file=sys.stderr)
+            return 2
+    try:
+        result = select_candidate(task, root) if mode == "select" else match_internal_capability(task, root)
+    except Exception as exc:
+        print(f"[PLW Error] candidate {mode} failed: {type(exc).__name__}: {exc}", file=sys.stderr)
+        return 1
+    if as_json:
+        print(json.dumps(result, indent=2, sort_keys=True))
+        return 0
+    print(f"# Candidate {mode}: {result.get('status')}")
+    selection = result if mode == "select" else result.get("selection", {}) or {}
+    if selection.get("selected_candidate"):
+        row = selection["selected_candidate"]
+        print(
+            f"# selected={row.get('candidate_id')} instance={row.get('candidate_instance_id')} "
+            f"kind={row.get('kind')} {row.get('source_path')}:{row.get('line_start')}-{row.get('line_end')} "
+            f"symbol={row.get('symbol')}"
+        )
+    else:
+        print(f"# reason={selection.get('reason', result.get('reason'))}")
+    if mode == "capability-match" and result.get("capability"):
+        capability = result["capability"]
+        print(f"# capability={capability.get('capability_id')} digest={capability.get('contract_digest')}")
+    print("# Authority: selection/match only; no authorization, execution, mutation, correctness, evidence acceptance, or truth.")
+    return 0
+
